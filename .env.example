# Copy to .env for Docker Compose. Never commit real keys.
POSTGRES_PASSWORD=modsage-local-only
MODSAGE_STEAM_API_KEY=
MODSAGE_LLM_API_KEY=
# Set both fields to a provider/model that you can actually access.
MODSAGE_LLM_BASE_URL=
MODSAGE_LLM_MODEL=
# Required only if enabling protected administrative HTTP operations.
MODSAGE_ADMIN_TOKEN=
