# Copy to .env for Docker Compose. Never commit real keys.
POSTGRES_PASSWORD=modsage-local-only
MODSAGE_STEAM_API_KEY=
MODSAGE_LLM_API_KEY=
# Set both fields to a provider/model that you can actually access.
MODSAGE_LLM_BASE_URL=
MODSAGE_LLM_MODEL=
# Required only if enabling protected administrative HTTP operations.
MODSAGE_ADMIN_TOKEN=

# Local API starts an embedded recommendation worker. Compose uses a dedicated service.
MODSAGE_RECOMMENDATION_WORKER_ENABLED=true
MODSAGE_RECOMMENDATION_POLL_SECONDS=0.5
MODSAGE_RECOMMENDATION_LEASE_SECONDS=30
MODSAGE_RECOMMENDATION_MAX_ATTEMPTS=3
MODSAGE_RECOMMENDATION_QUEUE_LIMIT=100
MODSAGE_RECOMMENDATION_SSE_SECONDS=25
MODSAGE_RECOMMENDATION_STREAM_LIMIT=32

# BM25 works locally. Hybrid retrieval requires explicit configuration and a prior backfill.
MODSAGE_RETRIEVAL_MODE=bm25
MODSAGE_RETRIEVAL_CATALOG_LIMIT=5000
MODSAGE_RETRIEVAL_CANDIDATE_LIMIT=50
# Separate embeddings credentials; no model calls occur in the default BM25 mode.
MODSAGE_EMBEDDING_API_KEY=
MODSAGE_EMBEDDING_BASE_URL=
MODSAGE_EMBEDDING_MODEL=
# Optional fixed output dimension, only for providers that support it. Blank means unspecified.
MODSAGE_EMBEDDING_DIMENSIONS=
MODSAGE_EMBEDDING_TIMEOUT_SECONDS=10
MODSAGE_EMBEDDING_MIN_SIMILARITY=0.35

# Optional daily worker. Start it with: docker compose --profile automation up --build -d
# A running worker is required; enabling this setting alone does not start one.
MODSAGE_REFRESH_ENABLED=false
# api requires MODSAGE_STEAM_API_KEY. public explicitly opts into bounded public-page discovery.
MODSAGE_REFRESH_SOURCE=api
# Daily schedule is in Asia/Shanghai (UTC+8).
MODSAGE_REFRESH_HOUR=8
MODSAGE_REFRESH_MINUTE=0
MODSAGE_REFRESH_LIMIT_PER_SORT=20
# 0 disables automatic model calls. Enrichment also requires configured model credentials.
MODSAGE_REFRESH_ENRICH_LIMIT=0
MODSAGE_REFRESH_MAX_ATTEMPTS=3
MODSAGE_REFRESH_LEASE_SECONDS=60
MODSAGE_REFRESH_REQUEST_BUDGET_SECONDS=180
MODSAGE_REFRESH_POLL_SECONDS=15
